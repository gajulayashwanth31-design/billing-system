# Local MySQL administrator credentials used by npm run db:setup.
MYSQL_ROOT_PASSWORD=

# Database setup settings. Copy this file to .env before running db:setup.
# Configure API settings separately in backend/.env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=billing_db
PORT=4000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INVOICE_SIGNING_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# These values match database/04_roles_and_grants.sql for a fresh demo.
# If you change them, update that SQL script to use the same values.
DB_CUSTOMER_PASS=CHANGE_ME_CUSTOMER_PASSWORD
DB_CASHIER_PASS=CHANGE_ME_CASHIER_PASSWORD
DB_ADMIN_PASS=CHANGE_ME_ADMIN_PASSWORD

CORS_ORIGIN=http://localhost:5173
DEMO_MODE=true
VITE_DEMO_MODE=true
VITE_API_URL=http://localhost:4000/api
WHATSAPP_PROVIDER=mock
PUBLIC_BASE_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:5173
UPI_ID=
SHOP_NAME=Billing System
SHOP_ADDRESS=
SHOP_GSTIN=
# Find the SID and token in the Twilio Console dashboard; find the sender in WhatsApp Sandbox settings.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
