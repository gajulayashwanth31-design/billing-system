# Docker Compose host ports
MYSQL_PORT=3307
API_PORT=4000
FRONTEND_PORT=5173

# Demo-only local values. Replace application secrets before deployment.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INVOICE_SIGNING_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# These values match database/04_roles_and_grants.sql for a fresh demo.
# If you change them, update that SQL script to use the same values.
DB_CUSTOMER_PASS=CHANGE_ME_CUSTOMER_PASSWORD
DB_CASHIER_PASS=CHANGE_ME_CASHIER_PASSWORD
DB_ADMIN_PASS=CHANGE_ME_ADMIN_PASSWORD

CORS_ORIGIN=http://localhost:5173
DEMO_MODE=true
VITE_DEMO_MODE=true
VITE_API_URL=http://localhost:4000/api
WHATSAPP_PROVIDER=mock
PUBLIC_BASE_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:5173
UPI_ID=
SHOP_NAME=Billing System
SHOP_ADDRESS=
SHOP_GSTIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
